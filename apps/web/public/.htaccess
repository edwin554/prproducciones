<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Redirigir www.prproduccionesbtl.com -> https://prproduccionesbtl.com (301, conserva ruta y parámetros)
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

	# Quitar la barra final: /servicios/ -> /servicios (una sola URL por página)
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.+)/$ /$1 [R=301,L]

	# Páginas pre-renderizadas: /servicios se sirve desde servicios.html
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME}.html -f
	RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Cualquier otra ruta: página 404 con su código de estado real
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
	Header unset X-Powered-By

	# Cabeceras de seguridad
	Header always set Strict-Transport-Security "max-age=31536000"
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

	# Cache everything on CDN by default
	Header set Cache-Control "public, s-maxage=604800, max-age=0"

	# Cache in browser all assets
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
</IfModule>
